# Backend Settings
PORT=5000
NODE_ENV=development

# Cơ sở dữ liệu NoSQL MongoDB chính thức của hệ thống Blog/CMS:
DATABASE_URL="mongodb://127.0.0.1:27017/blog_cms?replicaSet=rs0&directConnection=true"

# Khi chạy qua Docker Compose:
# DATABASE_URL="mongodb://mongodb:27017/blog_cms?replicaSet=rs0"

# Bảo mật và xác thực JWT
JWT_SECRET="ictu_blog_cms_super_secret_jwt_key_2026_vu_trong_nghia"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="ictu_cookie_secret_key_k23l"

# Cấu hình Frontend & Tải ảnh
FRONTEND_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5
