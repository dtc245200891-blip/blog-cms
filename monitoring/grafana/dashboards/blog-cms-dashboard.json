{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "HỆ THỐNG GIÁM SÁT BLOG/CMS - ĐẠI HỌC CÔNG NGHỆ THÔNG TIN VÀ TRUYỀN THÔNG (ICTU)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Tổng số lượng HTTP Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 3 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(blog_cms_http_requests_total) or vector(0)",
          "legendFormat": "Total Requests",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "blue", "value": 100 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 2,
      "title": "Tốc độ xử lý (Requests Per Second - RPS)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 3 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(blog_cms_http_requests_total[1m])) or vector(0)",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "reqps"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 3,
      "title": "Độ trễ trung bình p95 (Latency)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 3 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(blog_cms_http_request_duration_seconds_bucket[1m])) by (le)) or vector(0)",
          "legendFormat": "p95 Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 4,
      "title": "Thời gian Backend hoạt động (Uptime)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 3 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "blog_cms_process_uptime_seconds",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 5,
      "title": "Lưu lượng truy cập theo mã phản hồi HTTP (2xx, 4xx, 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(blog_cms_http_requests_total[1m])) by (status_code)",
          "legendFormat": "HTTP Status {{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Bộ nhớ Heap RAM tiêu thụ (Node.js Heap Memory)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "blog_cms_nodejs_heap_size_used_bytes",
          "legendFormat": "Heap Used",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "blog_cms_nodejs_heap_size_total_bytes",
          "legendFormat": "Heap Total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 7,
      "title": "Mức sử dụng CPU của tiến trình Backend (Node.js Process)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(blog_cms_process_cpu_user_seconds_total[1m]) * 100",
          "legendFormat": "CPU Usage %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Top các API Endpoints được gọi nhiều nhất",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 15 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "topk(5, sum(rate(blog_cms_http_requests_total[1m])) by (route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["blog-cms", "ictu", "monitoring", "devops"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
